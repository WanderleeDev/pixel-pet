{
  "name": "pixel-pet",
  "version": "0.1.0",
  "description": "Web component (Lit + TypeScript) que anima mascotas pixel art con CSS steps() a partir de una hoja de sprites y un manifiesto. Pensado para asistentes y chats.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./bundle": "./dist/pixel-pet.bundle.js",
    "./assets/*": "./assets/*"
  },
  "files": ["dist", "assets", "README.md", "LICENSE"],
  "sideEffects": ["./dist/define.js", "./dist/pixel-pet.bundle.js"],
  "scripts": {
    "dev": "vite",
    "demo": "vite --open",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src vite.config.ts vite.bundle.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src vite.config.ts vite.bundle.config.ts vitest.config.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && vite build -c vite.bundle.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["web-component", "lit", "typescript", "sprite", "pixel-art", "chatbot", "rag", "css-animation", "steps"],
  "license": "MIT",
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "lit": "^3.3.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
